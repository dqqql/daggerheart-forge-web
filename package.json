{
  "name": "daggerheart-forge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build && node scripts/build-server.mjs",
    "start": "node build/server.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "release:prepare": "npm run check && npm test && npm run build && node scripts/package.mjs",
    "skill:evidence": "node --experimental-strip-types skills/daggerheart-adversary-forge/scripts/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "Local Daggerheart adversary editor with a standalone skill and DeepSeek analysis",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dqqql/daggerheart-forge-web.git"
  }
}
