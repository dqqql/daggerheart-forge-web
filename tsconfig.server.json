{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["functions", "worker", "shared"]
}
